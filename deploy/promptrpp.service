[Unit]
Description=PromptRPP API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/gezypromptRPP
EnvironmentFile=/home/ubuntu/gezypromptRPP/.env.production
ExecStart=/usr/local/bin/bun /home/ubuntu/gezypromptRPP/apps/api/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/gezypromptRPP/data

[Install]
WantedBy=multi-user.target
